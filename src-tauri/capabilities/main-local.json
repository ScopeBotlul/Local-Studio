{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-local",
  "description": "Privileged commands for the local main webview only; hf-website has no capability.",
  "local": true,
  "permissions": [
    "allow-bootstrap",
    "allow-save-settings",
    "allow-get-hardware",
    "allow-list-jobs",
    "allow-enqueue-hash-job",
    "allow-cancel-job",
    "allow-dismiss-recovery",
    "allow-get-logs",
    "allow-mark-clean-exit",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "dialog:allow-confirm",
    "allow-hf-status",
    "allow-hf-start-login",
    "allow-hf-cancel-login",
    "allow-hf-connect-token",
    "allow-hf-logout",
    "allow-hf-verify",
    "allow-hf-search",
    "allow-hf-model-detail",
    "allow-hf-model-size",
    "allow-hf-open-page",
    "allow-hf-browser-mount",
    "allow-hf-browser-layout",
    "allow-hf-browser-hide",
    "allow-hf-browser-state",
    "allow-hf-browser-action",
    "allow-download-list",
    "allow-download-plan",
    "allow-download-start",
    "allow-download-action"
  ],
  "webviews": [
    "main"
  ]
}
