{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Studio",
  "version": "0.22.0",
  "identifier": "de.localstudio.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Local Studio",
        "width": 1440,
        "height": 940,
        "minWidth": 1000,
        "minHeight": 720,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://gallery.localhost http://project.localhost; img-src http://gallery.localhost http://project.localhost 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; media-src 'self' http://video.localhost http://gallery.localhost http://project.localhost",
      "capabilities": [
        "main-local"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Local AI creative workstation",
    "category": "GraphicsAndDesign",
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languages": [
          "German",
          "English"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
